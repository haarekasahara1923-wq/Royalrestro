# ==============================================================
# The Royal Comfort Hotel and Restaurant - Environment Configuration
# ==============================================================

# ── Neon Database (PostgreSQL) ────────────────────────────────
# Get this from your Neon Console (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-something-pooler.region.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-something.region.neon.tech/neondb?sslmode=require"

# Postgres Parameters (optional / for scripts)
PGHOST="ep-something.region.neon.tech"
PGHOST_UNPOOLED="ep-something.region.neon.tech"
PGUSER="user"
PGDATABASE="neondb"
PGPASSWORD="password"

# ── NextAuth Authentication ──────────────────────────────────
# Generate a random 32+ character string (e.g., using: openssl rand -base64 32)
NEXTAUTH_SECRET="your-random-secret-key-at-least-32-characters"
# In local dev: http://localhost:3000
# In production on Vercel: https://your-app-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Cloudinary (Image storage for dishes and logos) ───────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# ── Upstash Redis (SSE Real-time notifications & Menu Cache) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Razorpay Payment Gateway ─────────────────────────────────
# Get from Razorpay Dashboard (Test/Live mode keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Application Base URL ─────────────────────────────────────
# In local: http://localhost:3000
# In production: https://your-domain.vercel.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

